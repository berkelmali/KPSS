{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/live-postings",
      "destination": "/api/live-postings.js"
    },
    {
      "source": "/api/refresh-live",
      "destination": "/api/refresh-live.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
